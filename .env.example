# Database
DATABASE_URL=postgresql://hipost:${POSTGRES_PASSWORD:-changeme}@localhost:5436/hiai_post
POSTGRES_USER=hipost
POSTGRES_PASSWORD=your-secure-db-password

# Redis
REDIS_URL=redis://localhost:6383

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string-min
BETTER_AUTH_URL=http://localhost:50300
HIAI_ADMIN_JWT_SECRET=  # HS256 shared secret with hiai-admin proxy; required when serving behind the unified host
OAUTH_STATE_SECRET=  # Optional; if unset, derived from BETTER_AUTH_SECRET (signs OAuth state)

# Workspace (tenant) scoping — hiai-post frontend
# The backend scopes every protected /api/v1/* call to X-Tenant-Id (a
# tenants.id UUID). The SvelteKit proxy injects it server-side; set it to a
# valid workspace, e.g. the demo tenant created by `bun run db:seed`.
# Optional: an incoming X-Tenant-Id header (unified host mode) wins.
HIAI_TENANT_ID=

# hiai-kit feature backend (carousel + scriptforge) — optional; used by the
# Carousels / Scripts pages. Defaults to http://localhost:3000 when unset.
PUBLIC_HIAI_KIT_URL=

# hiai-kit integration boundary (server-side) — capability API
# (/api/v1/capabilities) + carousel jobs (/api/v1/carousel). hiai-kit runs as
# a peer service; default http://localhost:3000.
HIAI_KIT_URL=http://localhost:3000
HIAI_KIT_TIMEOUT_MS=30000
# Optional server-side credentials forwarded to hiai-kit as `Cookie` /
# `Authorization: Bearer` headers. hiai-kit gates writes behind a Better Auth
# session (requireAuth + agents:write), so protected calls fail with 401
# (HIAI_KIT_ERROR) when neither is set — authentication only works once a real
# session is configured. Never logged.
HIAI_KIT_COOKIE=
HIAI_KIT_TOKEN=

# Encryption (32+ char hex key for AES-256-GCM — generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32

# Social Platform API Keys
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Mastra / LLM
OPENROUTER_API_KEY=
OPENAI_API_KEY=  # Required for DALL·E 3 (image-gen.ts); falls back to placehold.co when unset
MASTRA_MODEL=openai/gpt-4o

# Web search (Tavily) — https://tavily.com — optional; web-search tool returns empty results when unset
TAVILY_API_KEY=

# Webhook (hiai-store integration)
HIAI_STORE_WEBHOOK_SECRET=  # Required to accept POST /api/v1/webhooks/store-product; HMAC SHA-256 of body

# Error tracking
SENTRY_DSN=  # Sentry-compatible DSN via hiai-observe; leave empty to disable

# hiai-observe telemetry (optional) — structured Writer/Carousel/Content
# (incl. approval)/Postiz/API/MCP/Webhook success/failure events via the OTLP
# /v1/logs endpoint, authenticated with the verified Bearer API-key contract
# (`Authorization: Bearer <key>`; the same contract hiai-kit's working OTLP
# clients use). Leave HIAI_OBSERVE_API_KEY empty (or remove all three) to
# disable telemetry entirely — the emitter is a no-op and never affects
# product requests.
HIAI_OBSERVE_URL=http://localhost:8001
HIAI_OBSERVE_API_KEY=
HIAI_OBSERVE_PROJECT=
HIAI_OBSERVE_TIMEOUT_MS=2000

# Postiz integration boundary (optional) — typed publication-intent submission
# / status-sync client ONLY. NOT wired into publishing, NOT backed by a queue,
# and does NOT claim live Postiz works without credentials: when URL or API key
# is unset the client reports NOT_CONFIGURED (503). Verify the endpoint paths
# against your Postiz deployment before enabling.
POSTIZ_API_URL=
POSTIZ_API_KEY=
POSTIZ_TIMEOUT_MS=10000

# Ports
API_PORT=50300
FRONTEND_PORT=50301

# Environment
NODE_ENV=development
